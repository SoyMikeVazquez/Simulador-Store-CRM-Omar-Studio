# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js build output
/.next/
/out/
/build

# environment files (protecting secrets & keys)
.env
.env*
.env.*
.env*.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# OS files
.DS_Store
**/.DS_Store
Thumbs.db
*.pem

# debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# generated PDFs & documents
*.pdf

# local test & scratch migration scripts
test-*.mjs
test_*.js
check-*.ts
update-*.ts
update-*.js
final-*.js
optimize-*.js
