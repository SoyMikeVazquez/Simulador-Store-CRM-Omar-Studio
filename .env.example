# Supabase Configuration
# La clave 'anon' es de acceso público en el cliente y está protegida por Row Level Security (RLS) en Supabase.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Correos electrónicos de los propietarios para recibir alertas de pedidos (separados por coma)
NEXT_PUBLIC_OWNER_EMAIL=admin@omarstudio.com.mx,barbersfc@omarstudio.com.mx

# Resend API Key (Privada)
# NOTA: En la arquitectura actual, los correos se envían a través de Supabase Edge Functions.
# Esta clave secreta NUNCA debe llevar el prefijo NEXT_PUBLIC_ ni subirse a GitHub.
# Debe configurarse directamente en los Secrets de Supabase:
# supabase secrets set RESEND_API_KEY=re_xxxxxxxxxxxx
RESEND_API_KEY=re_your_resend_api_key_here
