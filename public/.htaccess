Options -MultiViews
DirectoryIndex index.html

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Si el archivo solicitado existe físicamente, servirlo directamente
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Si el directorio solicitado existe físicamente y contiene index.html, servirlo
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^ - [L]

  # 3. Mapear rutas con trailing slash a su index.html (ej: /crm/ -> crm/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)/$ $1/index.html [L]

  # 4. Mapear rutas sin trailing slash a su index.html (ej: /crm -> crm/index.html)
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 5. Error 404 personalizado
  ErrorDocument 404 /404.html
</IfModule>

<IfModule mod_headers.c>
  # Prevenir caché en documentos HTML para que actualizaciones en Hostinger se reflejen al instante
  <FilesMatch "\.(html|txt)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </FilesMatch>

  # Cache eficiente para assets con hash inmutable
  <FilesMatch "\.(woff2|woff|ttf|png|jpe?g|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

<IfModule mod_mime.c>
  AddType font/ttf .ttf
  AddType font/woff2 .woff2
  AddType application/javascript .js
  AddType text/css .css
</IfModule>

